# Godot cache / import artefacts (regenerated by `godot --headless --path native --import`)
.godot/
*.translation
# Build outputs (tools/godot/build_ext.sh, tools/native-check.sh)
/build/
/ext/bin/
/ext/build/
# godot-cpp is fetched at a pinned SHA by tools/godot/build_ext.sh (see ext/README.md)
/ext/godot-cpp/
# Export outputs
/export/
*.apk
*.aab
*.ipa
