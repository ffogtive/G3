; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters
;
; 1차선 참교육 — native port (docs/NATIVE_PORT.md 3-1). Engine pin: Godot 4.7.2-stable (1-2).
; Planned autoload order (3-1): DB SaveGame InputBuffer Audio Haptics Fx UI.
; Registered so far: DB, SaveGame, Audio, Haptics (the others are added here, in this order, when their scripts land;
; InputBuffer/Fx/UI are still per-scene nodes of view/game.gd in M1a). Cfg (core/cfg.gd) is a `class_name` constants holder, not an autoload.

config_version=5

[application]

config/name="1차선 참교육"
config/version="0.1.0"
config/features=PackedStringArray("4.7", "Mobile")
run/main_scene="res://view/game.tscn"

[autoload]

DB="*res://core/db.gd"
SaveGame="*res://core/save_game.gd"
Progress="*res://meta/progress.gd"
Audio="*res://autoload/audio.gd"
Haptics="*res://autoload/haptics.gd"

[audio]

; iOS: Playback (3) plays through the silent switch; mix_with_others off = the game owns the output (autoload/audio.gd header).
general/ios/session_category=3
general/ios/mix_with_others=false

[debug]

gdscript/warnings/untyped_declaration=1

[display]

window/size/viewport_width=540
window/size/viewport_height=960
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[physics]

common/physics_ticks_per_second=120
common/max_physics_steps_per_frame=4
common/physics_interpolation=true

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=2
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
lights_and_shadows/directional_shadow/soft_shadow_filter_quality.mobile=3
