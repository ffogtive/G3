# ┌───────────────────────────────────────────────────────────────────────────────────────────────────────────┐
# │ ⚠️  ffogtive/G3 IS A PUBLIC REPOSITORY. DO NOT register a self-hosted runner on it.                        │
# │ GitHub: "We recommend that you only use self-hosted runners with private repositories. This is because    │
# │ forks of your public repository can potentially run dangerous code on your self-hosted runner machine by  │
# │ creating a pull request that executes the code in a workflow."                                            │
# │ https://docs.github.com/en/actions/hosting-your-own-runners/managing-self-hosted-runners/about-self-hosted-runners │
# │ https://docs.github.com/en/actions/security-for-github-actions/security-guides/security-hardening-for-github-actions#hardening-for-self-hosted-runners │
# │ A runner here = your Mac, its login keychain (Apple signing key) and your paired iPhone.                  │
# │ Use this file ONLY after one of:                                                                          │
# │   (a) making the repository private, or                                                                   │
# │   (b) a separate PRIVATE deploy repository that mirrors approved commits (recommended).                   │
# └───────────────────────────────────────────────────────────────────────────────────────────────────────────┘
#
# To activate (in the private repo, by a human):
#   1. Settings > Actions > Runners > New self-hosted runner (macOS); label it `iphone-deploy`. Run it as the Mac
#      user that is signed in to Xcode, from Terminal in the logged-in GUI session (keychain; guide §6) — not as a
#      LaunchDaemon.
#   2. Create the fixed deploy script OUTSIDE the checkout (pins what may run on the Mac):
#        ~/Deploy/lane1/deploy-iphone.command:
#          #!/bin/bash
#          set -euo pipefail
#          cd "$HOME/Deploy/lane1/source"
#          exec /bin/bash tools/mac/ios_run.sh --yes "$@"
#      chmod 700 it. Team/device come from ~/.lane1/deploy.env (chmod 600), never from the repo or the workflow.
#   3. Copy this file to .github/workflows/iphone-install.yml on the default branch AND on `iphone-deploy`.
#   4. From a session with GitHub access to that private repo:
#        gh workflow run iphone-install.yml --repo OWNER/PRIVATE_REPO --ref iphone-deploy
#        gh run list --repo OWNER/PRIVATE_REPO --workflow iphone-install.yml --branch iphone-deploy --limit 5
#        gh run watch RUN_ID --repo OWNER/PRIVATE_REPO --exit-status
#      A queued/green workflow is not proof of install: check the uploaded receipt (build/install/launch lines).
name: iPhone development install
on:
  workflow_dispatch: # manual only — never pull_request / push / schedule
permissions:
  contents: read
concurrency:
  group: iphone-deploy-lane1
  cancel-in-progress: false
jobs:
  install:
    if: github.ref == 'refs/heads/iphone-deploy'
    runs-on: [self-hosted, macOS, iphone-deploy]
    timeout-minutes: 30
    steps:
      - uses: actions/checkout@d23441a48e516b6c34aea4fa41551a30e30af803 # v6.1.0 (pin by SHA; re-verify before use)
        with:
          persist-credentials: false
      - name: Stage approved source and deploy
        shell: bash
        run: |
          set -euo pipefail
          stage="$HOME/Deploy/lane1/source"   # runner-private staging dir; never the user's projects/keychain
          mkdir -p "$stage"
          # Only what the build needs. .local (DerivedData, receipts) and native/.godot stay on the Mac.
          rsync -a --delete --exclude .local --exclude .godot --exclude xcuserdata --exclude 'native/ext/godot-cpp' \
            native tools "$stage/"
          /bin/bash "$HOME/Deploy/lane1/deploy-iphone.command"
      - name: Receipt
        if: always()
        shell: bash
        run: |
          set -euo pipefail
          last=$(ls -td "$HOME/Deploy/lane1/source/.local/deploy-runs"/* 2>/dev/null | head -n 1 || true)
          [ -n "$last" ] || { echo "no deploy run directory"; exit 1; }
          # receipt.txt has build/install/launch results + git SHA only (no Team ID / device ID).
          cat "$last/receipt.txt" "$last/exit-code"
